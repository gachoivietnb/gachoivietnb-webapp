# =====================================================
# GÀ CHỌI VIỆT NB — ENV CONFIGURATION
# Copy file này thành .env.local và điền thực tế vào
# =====================================================

# ---- Supabase (BẮT BUỘC cho Phần 1) ----
# Tạo project tại https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- Site URL ----
# Dev: http://localhost:3000 | Prod: https://gachoivietnb.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Google Drive OAuth (Phần 2 — có thể để trống ở Phần 1) ----
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google-drive/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ---- Gemini API (Phần 7 — để trống ở Phần 1) ----
# Lấy tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ---- Web Push VAPID (Phần 4 — để trống ở Phần 1) ----
# Generate bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gachoivietnb.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- Resend Email (Phần 4 — để trống ở Phần 1) ----
RESEND_API_KEY=
RESEND_FROM=alerts@gachoivietnb.com
ADMIN_EMAIL=admin@gachoivietnb.com

# ---- Cron Secret (Phần 4, 7 — để trống ở Phần 1) ----
CRON_SECRET=
